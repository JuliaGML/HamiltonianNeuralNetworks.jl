.DS_Store

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem
*.jl.*.mem

# Build artifacts of the documentation
docs/build/
docs/site/

# The network weights and the figures that the scripts write
/runs
/results
scripts/**/*.jld2
scripts/**/*.pdf
scripts/**/*.png

# File generated by Pkg, the package manager, based on a corresponding Project.toml. A package
# commits none.
Manifest.toml
